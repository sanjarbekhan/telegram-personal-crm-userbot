# Telegram API: https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash
PHONE_NUMBER=+998901234567
# Generate locally with: python -m app.make_session
TELETHON_SESSION=your_string_session_here

# Telegram admin bot from BotFather
ADMIN_BOT_TOKEN=123456:ABCDEF
ADMIN_TELEGRAM_ID=123456789

# Supabase (service_role is server-only; never expose or commit the real value)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# CRM limits
DAILY_SEND_LIMIT=100
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=40
SCAN_DAYS=30
RUN_INITIAL_SCAN=false
POLL_SECONDS=8

# Scheduled personal messages
TIMEZONE=Asia/Tashkent
SCHEDULE_POLL_SECONDS=5

# Bunyodkor CRM
SERVICE_PRICE_UZS=39000
SAMPLE_ARTICLE_URL=https://bunyodkor.com/bunyodkorlar/example
PUBLIC_OFFER_URL=https://bunyodkor.com/ommaviy_ofertasi
# Set after the structured application form is deployed.
APPLICATION_FORM_URL=
# Keep real card/payment information only in the hosting environment, never in GitHub.
PAYMENT_DETAILS=
DAILY_REPORT_HOUR=21
FOLLOW_UP_FIRST_HOURS=2
FOLLOW_UP_SECOND_HOURS=24
FOLLOW_UP_FINAL_HOURS=72
